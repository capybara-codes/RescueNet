# Frontend environment variables
# Copy this to .env.local and fill in your Firebase project config

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef123456

# Backend API URL (local dev)
VITE_API_URL=http://localhost:8000

# Mapbox public token (for map picker)
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token
